        <div class="big-price">${money(p.price)}</div>
        <p class="description">${escapeHTML(p.desc)}</p>
        ${p.sizes?`<div class="option-title">Choisir la taille</div><div class="sizes">${p.sizes.map(s=>`<button class="size ${s===selected?"selected":""}" data-size="${s}">${s}</button>`).join("")}</div>`:`<div class="option-title">Taille</div><p class="description">Taille unique.</p>`}
        <div class="buy-row">
          <div class="quantity"><button id="minus">−</button><span id="qty">1</span><button id="plus">+</button></div>
          <button class="btn primary" id="addDetail">Ajouter au panier</button>
        </div>
        <button class="btn full" id="directWA">Commander cette pièce sur WhatsApp</button>
        <div class="info-list">
          <details><summary>Livraison <span>+</span></summary><p>Livraison à Lomé et environs. 1 000 FCFA, offerte à partir de 50 000 FCFA.</p></details>
          <details><summary>Paiement <span>+</span></summary><p>Paiement à la livraison. La commande est confirmée directement sur WhatsApp.</p></details>
          <details><summary>Échanges <span>+</span></summary><p>Échange possible sous 48 heures après réception, selon les conditions de la boutique.</p></details>
        </div>
      </div>
    </section>
    <section class="section alt"><div class="container"><div class="section-head"><div><div class="eyebrow">Vous aimerez aussi</div><h2>Dans le même <em>univers.</em></h2></div></div>${renderProductGrid(PRODUCTS.filter(x=>x.cat===p.cat&&x.id!==p.id).slice(0,4))}</div></section>`;
  document.querySelectorAll("[data-size]").forEach(btn=>btn.onclick=()=>{
    document.querySelectorAll("[data-size]").forEach(x=>x.classList.remove("selected"));
    btn.classList.add("selected"); selected=btn.dataset.size;
  });
  document.getElementById("minus").onclick=()=>{qty=Math.max(1,qty-1);document.getElementById("qty").textContent=qty};
  document.getElementById("plus").onclick=()=>{qty=Math.min(20,qty+1);document.getElementById("qty").textContent=qty};
  document.getElementById("addDetail").onclick=()=>addToCart(p.id,selected,qty);
  document.getElementById("directWA").onclick=()=>{
    const msg=`Bonjour Manu Boutique !%0A%0AJe souhaite commander :%0A- ${encodeURIComponent(p.name)}%0A- Taille : ${encodeURIComponent(selected)}%0A- Quantité : ${qty}%0A- Prix : ${encodeURIComponent(money(p.price*qty))}%0A%0AMerci de me confirmer la disponibilité.`;
    window.location.href=`https://wa.me/${WA}?text=${msg}`;
  };
}

function renderCheckout(){
  if(!cart.length){
    app.innerHTML=`<section class="success"><div class="success-mark">♧</div><h1>Votre panier est vide.</h1><p>Ajoutez une ou plusieurs pièces avant de passer commande.</p><a class="btn primary" href="#/boutique">Retour à la boutique</a></section>`;
    return;
  }
  app.innerHTML=`
  <section class="page-head"><div class="container"><div class="eyebrow">Étape finale</div><h1>Finaliser <em>la commande.</em></h1><p>Vos informations seront ajoutées au message WhatsApp avec le récapitulatif de votre panier.</p></div></section>
  <section class="checkout"><div class="container checkout-grid">
    <form id="checkoutForm">
      <h2 class="form-title">Vos coordonnées</h2>
      <div class="field"><label>Nom complet *</label><input id="customerName" required placeholder="Ex. Awa Mensah"></div>
      <div class="field"><label>Téléphone *</label><input id="customerPhone" type="tel" required placeholder="Ex. 90 00 00 00"></div>
      <h2 class="form-title">Réception</h2>
      <div class="mode-grid">
        <label class="mode active"><input type="radio" name="mode" value="livraison" checked hidden><strong>Livraison</strong><span>À domicile à Lomé</span></label>
        <label class="mode"><input type="radio" name="mode" value="retrait" hidden><strong>Retrait</strong><span>En boutique</span></label>
      </div>
      <div class="field" id="addressField" style="margin-top:15px"><label>Quartier / adresse *</label><input id="customerAddress" placeholder="Ex. Bè-Kpota, près de..."></div>
      <div class="field"><label>Note facultative</label><textarea id="customerNote" rows="4" placeholder="Une précision pour la livraison..."></textarea></div>
      <button class="btn primary full" type="submit">Envoyer la commande sur WhatsApp →</button>
      <p style="font-size:11px;color:var(--muted);margin-top:10px">WhatsApp s'ouvrira avec un message déjà préparé. Le client appuie ensuite sur « Envoyer ».</p>
    </form>
    <aside class="summary">
      <h2>Récapitulatif</h2>
      ${cart.map(i=>`<div class="summary-line"><span>${escapeHTML(i.name)} · ${i.size} × ${i.qty}</span><b>${money(i.price*i.qty)}</b></div>`).join("")}
      <div class="summary-line"><span>Sous-total</span><b>${money(subtotal())}</b></div>
      <div class="summary-line"><span>Livraison</span><b id="summaryDelivery">${subtotal()>=FREE_FROM?"Offerte":"1 000 FCFA"}</b></div>
      <div class="summary-total"><span>Total</span><span id="summaryTotal">${money(subtotal()+(subtotal()>=FREE_FROM?0:DELIVERY))}</span></div>
    </aside>
  </div></section>`;
  document.querySelectorAll(".mode").forEach(label=>label.onclick=()=>{
    document.querySelectorAll(".mode").forEach(x=>x.classList.remove("active"));label.classList.add("active");
    const retrait=label.querySelector("input").value==="retrait";
    document.getElementById("addressField").style.display=retrait?"none":"";
    const del=retrait||subtotal()>=FREE_FROM?0:DELIVERY;
    document.getElementById("summaryDelivery").textContent=del?"1 000 FCFA":"Offerte";
    document.getElementById("summaryTotal").textContent=money(subtotal()+del);
  });
  document.getElementById("checkoutForm").onsubmit=e=>{
    e.preventDefault();
    const name=document.getElementById("customerName").value.trim();
    const phone=document.getElementById("customerPhone").value.trim();
    const retrait=document.querySelector('input[name="mode"]:checked').value==="retrait";
    const address=document.getElementById("customerAddress").value.trim();
    if(!name||!phone||(!retrait&&!address)){toast("Informations manquantes","Complétez les champs obligatoires.");return}
    const note=document.getElementById("customerNote").value.trim();
    const delivery=retrait||subtotal()>=FREE_FROM?0:DELIVERY;
    const lines=cart.map((i,n)=>`${n+1}. ${i.name} — ${i.size} × ${i.qty} = ${money(i.price*i.qty)}`).join("\n");
    const msg=`MANU BOUTIQUE — NOUVELLE COMMANDE

ARTICLES
${lines}

Sous-total : ${money(subtotal())}
Livraison : ${delivery?money(delivery):"Offerte"}
TOTAL : ${money(subtotal()+delivery)}

CLIENT
Nom : ${name}
Téléphone : ${phone}
Réception : ${retrait?"Retrait en boutique":"Livraison — "+address}
${note?"Note : "+note:""}`;
    const url=`https://wa.me/${WA}?text=${encodeURIComponent(msg)}`;
    cart=[];saveCart();updateCartUI();
    window.location.href=url;
    return;
    app.innerHTML=`<section class="success"><div class="success-mark">✓</div><h1>Commande <em>préparée.</em></h1><p>Votre récapitulatif a été ouvert dans WhatsApp. Il suffit maintenant d'appuyer sur « Envoyer » pour transmettre la commande à Manu Boutique.</p><a class="btn primary" href="${url}" target="_blank">Rouvrir WhatsApp →</a> <a class="btn" href="#/boutique">Continuer mes achats</a></section>`;
    window.scrollTo({top:0,behavior:"smooth"});
  };
}

/* -------- recherche -------- */
function openSearch(){document.getElementById("searchPanel").classList.add("open");document.getElementById("searchInput").focus();renderSearch("")}
function closeSearch(){document.getElementById("searchPanel").classList.remove("open")}
function renderSearch(q){
  q=q.trim().toLowerCase();
  const list=q?PRODUCTS.filter(p=>(p.name+" "+CAT[p.cat].title+" "+p.desc).toLowerCase().includes(q)):PRODUCTS.slice(0,7);
  document.getElementById("searchResults").innerHTML=list.map(p=>`<a class="search-result" href="#/produit/${p.id}" onclick="closeSearch()"><div class="mini-art">${svgArt(p.visual)}</div><div><strong>${escapeHTML(p.name)}</strong><div class="eyebrow">${CAT[p.cat].title} · ${money(p.price)}</div></div></a>`).join("")||`<p style="color:var(--muted);padding-top:20px">Aucun résultat.</p>`;
}
document.getElementById("searchInput").oninput=e=>renderSearch(e.target.value);

/* -------- routeur propre -------- */
function setActiveRoute(parts){
  document.querySelectorAll("#nav a").forEach(a=>a.classList.remove("active"));
  const key=parts[0]==="boutique"?parts[1]:"home";
  document.querySelector(`#nav a[data-route="${key}"]`)?.classList.add("active");
}
function route(){
  const raw=location.hash.replace(/^#\/?/,"");
  const parts=raw.split("/").filter(Boolean);
  setActiveRoute(parts);
  closeCart();closeSearch();
  if(parts[0]==="boutique")renderShop(CAT[parts[1]]?parts[1]:null);
  else if(parts[0]==="produit")renderProduct(parts[1]);
  else if(parts[0]==="commande")renderCheckout();
  else renderHome();
  window.scrollTo({top:0,behavior:"instant"});
}
window.addEventListener("hashchange",route);

/* -------- UI -------- */
document.getElementById("cartBtn").onclick=openCart;
document.getElementById("closeCart").onclick=closeCart;
document.getElementById("drawerBack").onclick=closeCart;
document.getElementById("searchBtn").onclick=openSearch;
document.getElementById("closeSearch").onclick=closeSearch;
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeCart();closeSearch()}});

document.getElementById("menuBtn").onclick=()=>{
  const links=["Accueil","Vêtements","Chaussures","Bijoux","Montres","Toute la boutique"];
  const hrefs=["#/","#/boutique/vetements","#/boutique/chaussures","#/boutique/bijoux","#/boutique/montres","#/boutique"];
  const panel=document.getElementById("mobilePanel");
  panel.style.cssText="display:flex;position:fixed;inset:0;z-index:70;background:#fff;flex-direction:column;padding:30px;gap:10px";
  panel.innerHTML=`<button onclick="this.parentElement.style.display='none'" style="align-self:flex-end;font-size:30px">×</button>`+links.map((x,i)=>`<a href="${hrefs[i]}" onclick="this.parentElement.style.display='none'" style="font:400 34px var(--serif);padding:15px 0;border-bottom:1px solid var(--line)">${x}</a>`).join("");
};

updateCartUI();
if(!location.hash)location.hash="#/";
route();
</script>
</body>
</html>
