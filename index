<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
:root{
  --white:#fff;
  --soft:#fff;
  --paper:#fff;
  --ink:#171717;
  --muted:#77746e;
  --line:#e7e3da;
  --green:#173d31;
  --green2:#0f2c24;
  --gold:#b38a48;
  --danger:#9b3d32;
  --serif:"Playfair Display",Georgia,serif;
  --sans:"DM Sans",Arial,sans-serif;
  --shadow:0 20px 60px rgba(23,23,23,.10);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--white);color:var(--ink);font:400 15px/1.65 var(--sans);overflow-x:hidden}
button,input,textarea{font:inherit}
button,a{color:inherit}
button{border:0;background:none;cursor:pointer}
a{text-decoration:none}
img{display:block;max-width:100%}
::selection{background:var(--green);color:#fff}
.container{width:min(1240px,calc(100% - 40px));margin:auto}
.eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.serif{font-family:var(--serif)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 21px;border:1px solid var(--ink);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;transition:.25s}
.btn:hover{background:var(--ink);color:#fff}
.btn.primary{background:var(--green);border-color:var(--green);color:#fff}
.btn.primary:hover{background:var(--green2);border-color:var(--green2)}
.btn.gold{background:var(--gold);border-color:var(--gold);color:#fff}
.btn.full{width:100%}
.icon{width:20px;height:20px;display:inline-block}
.topbar{background:var(--green);color:#fff;padding:8px 0;overflow:hidden;white-space:nowrap}
.topbar-track{display:flex;width:max-content;animation:marquee 24s linear infinite;gap:35px;font-size:10px;letter-spacing:.17em;text-transform:uppercase}
.topbar span{display:flex;align-items:center;gap:35px}
.dot{width:5px;height:5px;border-radius:50%;background:var(--gold);display:inline-block}
@keyframes marquee{to{transform:translateX(-50%)}}
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.header-row{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px}
.nav{display:flex;gap:25px}
.nav a{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#777;position:relative;padding:7px 0}
.nav a:after{content:"";position:absolute;left:0;bottom:0;width:100%;height:2px;background:var(--green);transform:scaleX(0);transform-origin:left;transition:.25s}
.nav a:hover,.nav a.active{color:var(--ink)}
.nav a:hover:after,.nav a.active:after{transform:scaleX(1)}
.logo{text-align:center;line-height:1}
.logo strong{display:block;font:600 27px var(--serif);letter-spacing:.18em}
.logo small{display:block;margin-top:4px;font-size:8px;font-weight:700;letter-spacing:.48em;text-transform:uppercase;color:var(--muted)}
.actions{display:flex;justify-content:flex-end;align-items:center;gap:4px}
.icon-btn{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;position:relative;transition:.2s}
.icon-btn:hover{background:var(--soft)}
.badge{position:absolute;right:1px;top:1px;min-width:17px;height:17px;padding:0 4px;border-radius:20px;background:var(--green);color:#fff;font-size:9px;font-weight:700;display:grid;place-items:center}
.mobile-menu{display:none}

.hero{padding:62px 0 72px;background:#fff}
.hero-grid{display:grid;grid-template-columns:1fr .82fr;align-items:center;gap:70px}
.hero h1{font:400 clamp(48px,7vw,92px)/.98 var(--serif);letter-spacing:-.04em;max-width:760px}
.hero h1 em{color:var(--green);font-style:italic}
.hero-copy{max-width:520px;color:var(--muted);font-size:16px;margin:24px 0 30px}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap}
.hero-art{position:relative;aspect-ratio:4/5;min-height:520px;background:var(--paper);overflow:hidden}
.hero-art .art-main{position:absolute;inset:0}
.hero-card{position:absolute;left:-30px;bottom:35px;width:190px;padding:14px;background:#fff;box-shadow:var(--shadow)}
.hero-card-art{aspect-ratio:1;background:var(--paper)}
.hero-card p{font:500 13px var(--serif);margin-top:9px}
.hero-note{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:45px;padding-top:12px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.12em}

.section{padding:82px 0}
.section.alt{background:#fff}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:35px;border-top:1px solid var(--ink);padding-top:15px}
.section-head h2{font:400 clamp(32px,4vw,55px)/1.05 var(--serif)}
.section-head h2 em{color:var(--green)}
.section-head p{max-width:470px;color:var(--muted)}

.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.category-card{position:relative;min-height:470px;background:var(--paper);overflow:hidden}
.category-card:nth-child(2),.category-card:nth-child(3),.category-card:nth-child(4){min-height:420px;margin-top:55px}
.category-card .art{position:absolute;inset:0;transition:transform .8s}
.category-card:hover .art{transform:scale(1.035)}
.category-card .label{position:absolute;left:18px;right:18px;bottom:18px;padding:18px;background:rgba(255,255,255,.94);display:flex;justify-content:space-between;align-items:center}
.category-card h3{font:400 25px var(--serif)}
.category-card small{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.15em}

.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px 16px}
.product-card{min-width:0}
.product-image{position:relative;aspect-ratio:4/5;background:#fff;overflow:hidden;border:1px solid var(--line)}
.product-image .art{position:absolute;inset:0;transition:transform .65s}
.product-card:hover .art{transform:scale(1.035)}
.product-tag{position:absolute;z-index:2;left:11px;top:11px;background:#fff;padding:6px 9px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.12em}
.product-tag.green{background:var(--green);color:#fff}
.quick{position:absolute;z-index:3;left:12px;right:12px;bottom:12px;background:#fff;padding:13px;text-align:center;font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;transform:translateY(70px);transition:.3s}
.product-card:hover .quick{transform:none}
.product-info{padding:13px 2px}
.product-cat{font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
.product-info h3{font:500 17px/1.25 var(--serif);margin:4px 0}
.price{font-size:13px;font-weight:700}
.product-info a:hover h3{color:var(--green)}

.split{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}
.split-art{aspect-ratio:1.1;background:var(--paper);overflow:hidden}
.split h2{font:400 clamp(32px,4vw,55px)/1.05 var(--serif)}
.split h2 em{font-style:italic;color:var(--green)}
.split p{color:var(--muted);margin:20px 0;max-width:520px}
.stats{display:flex;border-top:1px solid var(--ink);margin-top:28px}
.stat{flex:1;padding:15px 10px 0 0}
.stat+ .stat{border-left:1px solid var(--line);padding-left:15px}
.stat strong{display:block;font:500 29px var(--serif)}
.stat span{font-size:9px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}

.page-head{padding:58px 0 38px;background:var(--soft);border-bottom:1px solid var(--line)}
.page-head h1{font:400 clamp(48px,7vw,82px)/1 var(--serif);letter-spacing:-.035em;margin:8px 0 14px}
.page-head h1 em{color:var(--green)}
.page-head p{color:var(--muted);max-width:650px}
.filters{display:flex;gap:25px;padding:17px 0;border-bottom:1px solid var(--line);margin-bottom:35px}
.filters a{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);padding-bottom:4px;border-bottom:2px solid transparent}
.filters a.active,.filters a:hover{color:var(--ink);border-color:var(--green)}

.product-page{display:grid;grid-template-columns:1fr .8fr;gap:65px;padding:45px 0 90px}
.product-large{background:var(--paper);aspect-ratio:4/5;overflow:hidden}
.product-detail h1{font:400 clamp(34px,5vw,58px)/1.05 var(--serif);margin:7px 0 10px}
.product-detail .big-price{font-size:18px;font-weight:700;border-bottom:1px solid var(--line);padding-bottom:22px;margin-bottom:22px}
.product-detail .description{color:var(--muted);margin-bottom:25px}
.option-title{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.15em;margin-bottom:10px}
.sizes{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:24px}
.size{min-width:45px;height:42px;border:1px solid var(--line);font-size:11px;font-weight:700}
.size:hover,.size.selected{background:var(--ink);color:#fff;border-color:var(--ink)}
.buy-row{display:flex;gap:8px;margin-bottom:12px}
.quantity{display:flex;border:1px solid var(--line)}
.quantity button{width:42px}
.quantity span{width:40px;display:grid;place-items:center;font-weight:700}
.buy-row .btn{flex:1}
.info-list{border-top:1px solid var(--line);margin-top:25px}
.info-list details{border-bottom:1px solid var(--line);padding:15px 0}
.info-list summary{cursor:pointer;list-style:none;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.13em;display:flex;justify-content:space-between}
.info-list summary::-webkit-details-marker{display:none}
.info-list p{color:var(--muted);font-size:13px;padding-top:10px}

.drawer-back{position:fixed;inset:0;background:rgba(0,0,0,.38);z-index:80;opacity:0;pointer-events:none;transition:.3s}
.drawer-back.open{opacity:1;pointer-events:auto}
.drawer{position:fixed;z-index:90;right:0;top:0;bottom:0;width:min(470px,100vw);background:#fff;transform:translateX(102%);transition:.4s;display:flex;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,.12)}
.drawer.open{transform:none}
.drawer-head{display:flex;justify-content:space-between;align-items:center;padding:20px;border-bottom:1px solid var(--line)}
.drawer-head h2{font:400 25px var(--serif)}
.drawer-body{flex:1;overflow:auto;padding:0 20px}
.empty{height:100%;display:grid;place-items:center;text-align:center;color:var(--muted);padding:40px}
.empty h3{font:400 27px var(--serif);color:var(--ink);margin:10px}
.cart-line{display:grid;grid-template-columns:75px 1fr auto;gap:12px;padding:16px 0;border-bottom:1px solid var(--line)}
.cart-thumb{width:75px;height:92px;background:var(--paper);overflow:hidden}
.cart-line h3{font:500 15px var(--serif);line-height:1.25}
.cart-meta{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin:5px 0}
.mini-qty{display:flex;align-items:center;border:1px solid var(--line);width:max-content}
.mini-qty button{width:28px;height:28px}
.mini-qty span{width:28px;text-align:center;font-size:11px;font-weight:700}
.cart-right{text-align:right;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end}
.remove{font-size:18px;color:#aaa}
.remove:hover{color:var(--danger)}
.drawer-foot{padding:20px;border-top:1px solid var(--ink)}
.total-line{display:flex;justify-content:space-between;margin:5px 0}
.total-line.total{font:500 22px var(--serif);margin:12px 0 16px}
.note{font-size:11px;color:var(--muted);margin-bottom:14px}

.checkout{padding:50px 0 90px}
.checkout-grid{display:grid;grid-template-columns:1fr .75fr;gap:60px}
.form-title{font:400 28px var(--serif);margin:25px 0 16px}
.form-title:first-child{margin-top:0}
.field{margin-bottom:15px}
.field label{display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.15em;color:var(--muted);margin-bottom:6px}
.field input,.field textarea{width:100%;border:1px solid var(--line);padding:13px 14px;outline:none;background:#fff}
.field input:focus,.field textarea:focus{border-color:var(--green)}
.mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.mode{border:1px solid var(--line);padding:14px;cursor:pointer}
.mode.active{border-color:var(--green);background:#f3f7f4}
.mode strong{display:block;font:500 16px var(--serif)}
.mode span{font-size:11px;color:var(--muted)}
.summary{border:1px solid var(--line);padding:22px;height:max-content;position:sticky;top:100px}
.summary h2{font:400 25px var(--serif);padding-bottom:13px;border-bottom:1px solid var(--line)}
.summary-line{display:flex;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--line);font-size:12px}
.summary-total{font:500 22px var(--serif);display:flex;justify-content:space-between;padding-top:17px}
.success{text-align:center;padding:100px 20px}
.success-mark{width:72px;height:72px;border:1px solid var(--green);border-radius:50%;display:grid;place-items:center;margin:0 auto 20px;color:var(--green);font-size:30px}
.success h1{font:400 clamp(36px,6vw,65px) var(--serif)}
.success p{max-width:600px;color:var(--muted);margin:15px auto 25px}

.toast-wrap{position:fixed;z-index:200;left:20px;bottom:20px;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--ink);color:#fff;padding:13px 16px;min-width:280px;box-shadow:var(--shadow);border-left:3px solid var(--gold);animation:toastIn .35s}
.toast strong{display:block;font-size:12px}
.toast span{display:block;font-size:11px;color:#ccc}
@keyframes toastIn{from{opacity:0;transform:translateY(12px)}}
footer{border-top:1px solid var(--line);background:var(--soft)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.2fr;gap:40px;padding:55px 0 35px}
.footer-grid p{color:var(--muted);max-width:330px;margin-top:15px;font-size:13px}
footer h4{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:13px}
footer ul{list-style:none}
footer li{margin:6px 0}
footer a:hover{color:var(--green)}
.footer-bottom{border-top:1px solid var(--line);padding:15px 0;display:flex;justify-content:space-between;color:var(--muted);font-size:10px}

.search{position:fixed;inset:0;background:#fff;z-index:100;transform:translateY(-100%);transition:.35s;padding:20px}
.search.open{transform:none}
.search-inner{max-width:850px;margin:70px auto}
.search-inner input{width:100%;border:0;border-bottom:1px solid var(--ink);outline:0;font:italic 400 45px var(--serif);padding:12px 0}
.search-results{margin-top:20px}
.search-result{display:flex;align-items:center;gap:15px;padding:12px 0;border-bottom:1px solid var(--line)}
.search-result .mini-art{width:55px;height:65px;background:var(--paper)}

@media(max-width:900px){
  .nav{display:none}
  .header-row{grid-template-columns:42px 1fr 1fr}
  .mobile-menu{display:grid}
  .hero-grid,.split,.product-page,.checkout-grid{grid-template-columns:1fr}
  .hero-art{min-height:500px}
  .category-grid{grid-template-columns:1fr 1fr}
  .category-card:first-child{grid-column:auto}
  .category-card:nth-child(2),.category-card:nth-child(3),.category-card:nth-child(4){margin-top:0}
  .product-grid{grid-template-columns:repeat(3,1fr)}
  .footer-grid{grid-template-columns:1fr 1fr}
  .summary{position:static}
}
@media(max-width:600px){
  .container{width:min(100% - 28px,1240px)}
  .header-row{height:68px}
  .hero{padding:35px 0 45px}
  .hero-art{min-height:410px}
  .hero-card{width:145px;left:10px;bottom:15px}
  .category-grid,.product-grid{grid-template-columns:1fr 1fr}
  .category-card,.category-card:nth-child(2),.category-card:nth-child(3),.category-card:nth-child(4){min-height:300px}
  .product-grid{gap:22px 9px}
  .quick{transform:none;font-size:8px;padding:10px}
  .section{padding:55px 0}
  .section-head{display:block}
  .section-head p{margin-top:10px}
  .buy-row{flex-wrap:wrap}
  .quantity{width:100%;justify-content:center;height:46px}
  .buy-row .btn{width:100%}
  .mode-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .footer-bottom{display:block}
  .footer-bottom span{display:block;margin:4px 0}
  .search-inner input{font-size:30px}
}
.photo-art{width:100%;height:100%;object-fit:contain;background:#fff;padding:12px}.category-card .photo-art{padding:22px}.hero-art .photo-art{padding:24px}.split-art .photo-art{padding:24px}.mini-art .photo-art{padding:5px}.cart-thumb .photo-art{padding:4px}
</style>
</head>
