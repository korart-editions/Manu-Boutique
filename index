/* -------- panier -------- */
let cart = JSON.parse(localStorage.getItem("manu-cart-v2") || "[]");
const saveCart = ()=>localStorage.setItem("manu-cart-v2",JSON.stringify(cart));
const countCart = ()=>cart.reduce((s,i)=>s+i.qty,0);
const subtotal = ()=>cart.reduce((s,i)=>s+i.qty*i.price,0);

function toast(title,msg=""){
  const el=document.createElement("div");
  el.className="toast";
  el.innerHTML=`<strong>${escapeHTML(title)}</strong><span>${escapeHTML(msg)}</span>`;
  document.getElementById("toasts").appendChild(el);
  setTimeout(()=>el.remove(),3300);
}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));}

function addToCart(id,size="Unique",qty=1){
  const p=findProduct(id); if(!p)return;
  if(p.sizes && !size) size=p.sizes[0];
  const existing=cart.find(i=>i.id===p.id && i.size===size);
  if(existing) existing.qty+=qty;
  else cart.push({id:p.id,name:p.name,price:p.price,size:size,qty:qty,visual:p.visual});
  saveCart(); updateCartUI(); toast("Ajouté au panier",`${p.name} — ${size}`);
  openCart();
}
function changeQty(index,delta){
  if(!cart[index])return;
  cart[index].qty+=delta;
  if(cart[index].qty<=0)cart.splice(index,1);
  saveCart(); updateCartUI();
}
function removeLine(index){
  cart.splice(index,1); saveCart(); updateCartUI();
}
function updateCartUI(){
  const n=countCart();
  document.getElementById("cartBadge").textContent=n;
  renderDrawer();
}
function renderDrawer(){
  const body=document.getElementById("drawerBody"),foot=document.getElementById("drawerFoot");
  if(!cart.length){
    body.innerHTML=`<div class="empty"><div><div style="font-size:45px">♧</div><h3>Votre panier est vide</h3><p>Ajoutez vos pièces préférées pour préparer votre commande.</p><a class="btn primary" href="#/boutique">Découvrir la boutique</a></div></div>`;
    foot.innerHTML="";
    return;
  }
  body.innerHTML=cart.map((i,index)=>`
    <div class="cart-line">
      <div class="cart-thumb">${svgArt(i.visual)}</div>
      <div>
        <h3>${escapeHTML(i.name)}</h3>
        <div class="cart-meta">Taille : ${escapeHTML(i.size)}</div>
        <div class="mini-qty"><button onclick="changeQty(${index},-1)">−</button><span>${i.qty}</span><button onclick="changeQty(${index},1)">+</button></div>
      </div>
      <div class="cart-right"><button class="remove" onclick="removeLine(${index})">×</button><b>${money(i.price*i.qty)}</b></div>
    </div>`).join("");
  const sub=subtotal(),delivery=sub>=FREE_FROM?0:DELIVERY;
  foot.innerHTML=`
    <div class="total-line"><span>Sous-total</span><b>${money(sub)}</b></div>
    <div class="total-line"><span>Livraison</span><b>${delivery?"1 000 FCFA":"Offerte"}</b></div>
    <div class="total-line total"><span>Total</span><span>${money(sub+delivery)}</span></div>
    <div class="note">${delivery?"Livraison offerte à partir de 50 000 FCFA.":"Vous bénéficiez de la livraison offerte."}</div>
    <a class="btn primary full" href="#/commande" onclick="closeCart()">Passer commande sur WhatsApp</a>`;
}
function openCart(){document.getElementById("drawer").classList.add("open");document.getElementById("drawerBack").classList.add("open")}
function closeCart(){document.getElementById("drawer").classList.remove("open");document.getElementById("drawerBack").classList.remove("open")}

